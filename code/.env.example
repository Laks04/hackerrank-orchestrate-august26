# Copy this file to .env (next to main.py) and fill in your own key, or export
# it directly in your shell. Never commit a real key.
#
# Optional - enables the Claude vision/text reasoning layer on top of the
# deterministic rules engine. If unset, the router runs in pure rules mode
# and still produces a full, valid output.csv.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
ROUTER_TEXT_MODEL=claude-sonnet-4-5-20250929
ROUTER_VISION_MODEL=claude-sonnet-4-5-20250929
